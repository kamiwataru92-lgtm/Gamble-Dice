rules_version = '2';
// 友達同士で遊ぶ前提の最低限のルール。ゲーム判定の正しさまでは保証しない（設計書 6.2）。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // 管理者（Firebase コンソールで作ったメール / パスワードのアカウント）。src/admin/config.ts と同じ UID にする
    function isAdmin() { return signedIn() && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (request.method == 'get' || request.method == 'list'
            || (request.resource.data.coins is int && request.resource.data.coins >= 0));
      // 管理者は全員の一覧を見て、コインと所持品を変更できる（ユーザーの作成・削除はしない）
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.coins is int && request.resource.data.coins >= 0;
    }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.players;
      // 既存の参加者（開始前に自分を外して抜ける場合も含む）、または自分を players に加えて参加する人だけが更新できる
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players
        || (resource.data.status == 'waiting' && request.auth.uid in request.resource.data.players)
      );
    }
  }
}
