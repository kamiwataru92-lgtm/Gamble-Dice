rules_version = '2';
// 友達同士で遊ぶ前提の最低限のルール。ゲーム判定の正しさまでは保証しない（設計書 6.2）。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (request.method == 'get' || request.method == 'list'
            || (request.resource.data.coins is int && request.resource.data.coins >= 0));
      // 管理画面（/admin、パスワードは画面側だけの簡易ロック）用：ログインしていれば全員の一覧を見て、
      // コインと所持品を変更できる。身内で遊ぶ前提の割り切り（作成・削除・マイナスは不可）
      allow read: if signedIn();
      allow update: if signedIn() && request.resource.data.coins is int && request.resource.data.coins >= 0;
    }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
      // 今のゲームの参加者、前のゲームの精算待ちの人、または次のゲームに自分を加えて参加する人だけが更新できる
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players
        || request.auth.uid in resource.data.get('unsettled', {})
        || (resource.data.status == 'waiting' && request.auth.uid in request.resource.data.players)
      );
    }
  }
}
