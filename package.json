{
  "name": "gamble-dice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-gamble",
    "dev:emu": "VITE_USE_EMULATOR=1 VITE_FIRESTORE_DATABASE=default VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_AUTH_DOMAIN=demo-gamble.firebaseapp.com VITE_FIREBASE_PROJECT_ID=demo-gamble VITE_FIREBASE_APP_ID=1:1:web:1 vite"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^12.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
