[debug] [2026-11-23T02:39:23.694Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-gamble:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n// 友達同士で遊ぶ前提の最低限のルール。ゲーム判定の正しさまでは保証しない（設計書 6.2）。\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n\n    match /users/{uid} {\n      allow read, write: if signedIn() && request.auth.uid == uid\n        && (request.method == 'get' || request.method == 'list'\n            || (request.resource.data.coins is int && request.resource.data.coins >= 0));\n    }\n\n    match /rooms/{code} {\n      allow read: if signedIn();\n      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid\n        && request.auth.uid in request.resource.data.players;\n      // 既存の参加者（開始前に自分を外して抜ける場合も含む）、または自分を players に加えて参加する人だけが更新できる\n      allow update: if signedIn() && (\n        request.auth.uid in resource.data.players\n        || (resource.data.status == 'waiting' && request.auth.uid in request.resource.data.players)\n      );\n    }\n  }\n}\n"}]}}
